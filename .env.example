# Copy to .env to change any of these. Every value below is the default, so
# the app also runs with no .env at all. There are no secrets here: do not
# commit real credentials, put them in .env (git-ignored).

# --- Ports on your machine ---------------------------------------------------
WEB_PORT=3000
API_PORT=4000
MAILPIT_UI_PORT=8025

# --- Product data ------------------------------------------------------------
# fakestore = live Fake Store API (through our backend); if it is down, the
#             API serves the bundled snapshot instead and logs a warning
# fixture   = bundled snapshot only, never calls Fake Store
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_SECONDS=300

# --- Database ----------------------------------------------------------------
MONGODB_DB=catalogue

# --- Email -------------------------------------------------------------------
# smtp    = send through SMTP (Mailpit in Docker; any SMTP provider later)
# console = print the email in the API log instead of sending it
EMAIL_PROVIDER=smtp
MAIL_FROM=catalogue@example.test
SALES_INBOX=sales@example.test
# Where customers reach the site; the sales email links to the product there.
# If you change WEB_PORT, change this to match.
PUBLIC_WEB_URL=http://localhost:3000

# Which SMTP server sends the email. Left unset, Docker uses its Mailpit
# container and `npm run dev` uses localhost:1025 (Mailpit from the dev
# compose file). Setting these switches to a real provider, for example
# Amazon SES, with no code change. Docker Compose passes them through, so set
# them only when you mean it: SMTP_HOST=localhost here would break the
# Docker run, because inside the container "localhost" is the API itself.
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Unset, port 465 uses TLS from the first byte and others upgrade; true/false forces it.
# SMTP_SECURE=

# --- Only when running the API outside Docker (npm run dev) ------------------
# Docker Compose ignores these and uses its own containers.
# MONGODB_URI=mongodb://localhost:27017
# MONGO_PORT=27017
# MAILPIT_SMTP_PORT=1025
